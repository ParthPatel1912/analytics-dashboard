PORT=4000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ANALYTICS_ENDPOINT=http://localhost:4000/api/v1/events/batch
WEB_ORIGIN=http://localhost:3000
SQLITE_FILE=./analytics.sqlite
# Optional: postgres://user:password@localhost/analytics or mysql://user:password@localhost/analytics
# DATABASE_URL=
# These are public, local-demo credentials. Replace all three before deployment.
DEMO_PUBLIC_KEY=pk_local_restaurant
DEMO_SECRET_KEY=sk_local_restaurant_change_me
DASHBOARD_TOKEN=dashboard_local_change_me
RATE_LIMIT=120
BLOCK_BOTS=false
# Analytics executes after the order response; synchronous ingestion remains default.
# Optional QA-only settings (not needed for npm run dev):
# TEST_DATABASE_URL=postgres://user:password@localhost/analytics_test
# PLAYWRIGHT_CHANNEL=msedge
# API_EXAMPLE_BASE=http://127.0.0.1:4000
# NEXT_TELEMETRY_DISABLED=1

{
  "name": "table-and-tally",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "npm run build:sdks && npm run setup && concurrently -k -n api,web \"npm run dev -w @app/api\" \"npm run dev -w @app/web\"",
    "build:sdks": "npm run build -w @pkg/sdk-js && npm run build -w @pkg/sdk-node",
    "build": "npm run build:sdks && npm run build -w @app/api && npm run build -w @app/web",
    "setup": "tsx apps/api/src/cli.ts setup",
    "migrate": "tsx apps/api/src/cli.ts migrate",
    "seed:demo": "tsx apps/api/src/cli.ts demo",
    "smoke": "tsx apps/api/test/smoke.ts",
    "test": "vitest run",
    "test:api": "vitest run apps/api",
    "test:sdk": "vitest run packages",
    "test:packages": "npm run build:sdks && node --test scripts/packages.test.mjs",
    "test:mutations": "node scripts/mutations.mjs",
    "test:report": "vitest run --reporter=json --outputFile=.audit/unit.json && node scripts/test-summary.mjs",
    "test:e2e": "npm run build:sdks && tsx scripts/e2e.ts",
    "test:failures": "tsx scripts/failure-e2e.ts",
    "test:postgres": "tsx scripts/database-e2e.ts",
    "test:postgres:local": "node scripts/portable-postgres.mjs",
    "test:ui": "npm run build:sdks && playwright test",
    "explain": "tsx scripts/explain.ts",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p packages/sdk-js && tsc --noEmit -p packages/sdk-node && tsc --noEmit -p apps/web && tsc --noEmit -p scripts",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "type": "module"
}
